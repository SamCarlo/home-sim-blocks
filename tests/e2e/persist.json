[
  {
    "waitReady": true
  },
  {
    "click": "#tab-register"
  },
  {
    "type": [
      "#panel-register input[name=username]",
      "persistkid"
    ]
  },
  {
    "type": [
      "#panel-register input[name=classCode]",
      "DEMO"
    ]
  },
  {
    "type": [
      "#panel-register input[name=password]",
      "password123"
    ]
  },
  {
    "type": [
      "#panel-register input[name=confirm]",
      "password123"
    ]
  },
  {
    "click": "#panel-register button[type=submit]"
  },
  {
    "waitFor": ".app-header"
  },
  {
    "waitReady": true
  },
  {
    "assert": "window.__homesim && window.__homesim.getState().phase === 'intake'"
  },
  {
    "eval": "window.__homesim.update((s) => { s.player.jobTitle = 'Lifeguard'; s.player.weeklyJobHours = 32; }, { checkpoint: 'e2e' }); window.__homesim.getState().player"
  },
  {
    "goto": "/index.html"
  },
  {
    "waitReady": true
  },
  {
    "assert": "window.__homesim.getState().player.jobTitle === 'Lifeguard' && window.__homesim.getState().player.weeklyJobHours === 32"
  },
  {
    "assert": "JSON.parse(localStorage.getItem('homeblocks:v1:save:' + window.__homesim.user.uid)).player.jobTitle === 'Lifeguard'"
  },
  {
    "eval": "window.__homesim.getState().meta.saveCount"
  },
  {
    "shot": "tools/shots/e2e-persist.png"
  }
]
